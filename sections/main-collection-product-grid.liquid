{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more'
	or settings.pagination_type == 'infinite_scroll'
-%}
	<script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
	{{ 'component-facets.css' | asset_url | stylesheet_tag }}
	<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'facets-menu.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
	{% render 'spaced-section' %}
{%- endstyle -%}

{%- liquid
	assign filter_layout_setting = section.settings.filter_layout | default: 'drawer'
	assign use_vertical_filter_layout = false
	if section.settings.enable_filtering and filter_layout_setting == 'vertical'
		assign use_vertical_filter_layout = true
	endif
-%}
{%- if collection.all_products_count > 0 -%}
	{%- if section.settings.enable_filtering
		or section.settings.enable_sorting
	-%}
		{%- if use_vertical_filter_layout -%}
			<div class="collection-with-filters collection-with-filters--vertical">
		{%- endif -%}
		<div class="facets__main">
			{% render 'facets',
				results: collection,
				enable_filtering: section.settings.enable_filtering,
				enable_sorting: section.settings.enable_sorting,
				default_open: section.settings.default_open,
				taypes_position: section.settings.taypes_position,
				facets_count_type: section.settings.facets_count_type,
				per_page: section.settings.products_per_page,
				image_filter_ratio: section.settings.image_filter_ratio,
				image_filter_fit: section.settings.image_filter_fit,
				image_filter_columns: section.settings.image_filter_columns,
				filter_layout: filter_layout_setting
			%}
		</div>
	{%- endif -%}
{%- endif -%}

<div
	id="ProductGridContainer"
	class="section-{{ section.id }}-padding collection__main-wrapper{% if use_vertical_filter_layout %} collection-with-filters__grid{% endif %}"
	data-per-page="{{ section.settings.products_per_page }}"
>
	{%- paginate collection.products by section.settings.products_per_page -%}
		{%- if collection.products.size == 0 -%}
			<div
				class="collection collection-product collection--empty container"
				id="product-grid"
				data-id="{{ section.id }}"
			>
				<div class="loading-overlay">
					<div class="loading-overlay__spinner">
						<svg
							aria-hidden="true"
							focusable="false"
							role="presentation"
							class="spinner"
							viewBox="0 0 66 66"
							xmlns="http://www.w3.org/2000/svg"
						>
							<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
						</svg>
					</div>
				</div>
				<div class="title-wrapper center title-wrapper-empty">
					<h2 class="title title--primary">
						{% if collection.all_products_count == 0 %}
							{{ 'sections.collection_template.empty' | t -}}
							<br>
							{{
								'sections.collection_template.use_fewer_filters_html'
								| t: link: routes.collections_url, class: 'underlined-link link'
							}}
						{% else %}
							{{ 'sections.collection_template.empty_results' | t -}}
							<br>
							{{
								'sections.collection_template.results_use_fewer_filters_html'
								| t: link: collection.url, class: 'underlined-link link'
							}}
						{% endif %}
					</h2>
				</div>
			</div>
		{%- else -%}
			<div class="collection collection-product container">
				<div class="loading-overlay">
					<div class="loading-overlay__spinner">
						<svg
							aria-hidden="true"
							focusable="false"
							role="presentation"
							class="spinner"
							viewBox="0 0 66 66"
							xmlns="http://www.w3.org/2000/svg"
						>
							<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
						</svg>
					</div>
				</div>
				{% assign mobile_card_count = section.settings.mobile_card_count %}
				{% style %}
					#product-grid {
						--per-row : {{ section.settings.per_row }};
						{% if mobile_card_count %}
							--mobile-per-row : 2;
						{% else %}
							--mobile-per-row : 1;
						{% endif %}
					}
				{% endstyle %}
				<div
					id="product-grid"
					data-id="{{ section.id }}"
					class="collection-product-list load-more-grid{% if mobile_card_count %} collection-product-list-row{% endif %}"
				>
					{%- liquid
						assign active_option_filters = ''
						assign filter_url = paginate.next.url
						if filter_url == blank
							assign filter_url = paginate.previous.url
						endif
						if filter_url == blank
							assign filter_url = collection.url
						endif
						if filter_url != blank and filter_url contains 'filter.v.option.'
							assign query_string = filter_url | split: '?' | last
							assign param_pairs = query_string | split: '&'
							for param_pair in param_pairs
								if param_pair contains 'filter.v.option.'
									assign nv = param_pair | split: '='
									assign opt_name = nv[0] | remove: 'filter.v.option.'
									if nv.size > 1
										assign opt_value = nv[1] | replace: '+', ' '
										assign filter_entry = opt_name | append: '||' | append: opt_value
										assign active_option_filters = active_option_filters | append: ';;' | append: filter_entry
									endif
								endif
							endfor
						endif
						if active_option_filters == '' and content_for_header contains 'filter.v.option.'
							assign header_parts = content_for_header | split: '"pageurl":"'
							if header_parts.size > 1
								assign pageurl = header_parts[1] | split: '"' | first
								if pageurl contains 'filter.v.option.'
									assign query_string = pageurl | split: '?' | last
									assign param_pairs = query_string | split: '&'
									for param_pair in param_pairs
										if param_pair contains 'filter.v.option.'
											assign nv = param_pair | split: '='
											assign opt_name = nv[0] | remove: 'filter.v.option.'
											if nv.size > 1
												assign opt_value = nv[1] | replace: '+', ' '
												assign filter_entry = opt_name | append: '||' | append: opt_value
												assign active_option_filters = active_option_filters | append: ';;' | append: filter_entry
											endif
										endif
									endfor
								endif
							endif
						endif
					-%}
					{%- for product in collection.products -%}
						{% liquid
							assign condition = paginate.current_offset | plus: forloop.index | modulo: section.settings.per_row
							if condition == 0
								assign block_class = 'hide_border'
							else
								assign block_class = ''
							endif
						%}
						{%- liquid
							assign matching_variant = nil
							if active_option_filters != ''
								assign filters_list = active_option_filters | split: ';;'
								for variant in product.variants
									assign matches_all = true
									for filter_entry in filters_list
										if filter_entry != ''
											assign parts = filter_entry | split: '||'
											assign filter_opt_name = parts[0]
											assign filter_opt_value = parts[1]
											assign found = false
											for product_option in product.options
												assign product_option_handle = product_option | handle | strip
												if product_option_handle == filter_opt_name
													assign index = forloop.index0
													if variant.options[index] == filter_opt_value
														assign found = true
													endif
													break
												endif
											endfor
											if found == false
												assign matches_all = false
											endif
										endif
									endfor
									if matches_all
										assign matching_variant = variant
										break
									endif
								endfor
							endif
						-%}
						{%- if matching_variant != blank and matching_variant.available == false -%}
							{%- continue -%}
						{%- endif -%}
						<div class="collection-product-card {% if settings.quickview_hover %}quickview--hover{% endif %} {{ block_class }}">
							{% render 'product-card',
								product_card_product: product,
								matching_variant: matching_variant,
								media_size: section.settings.image_ratio,
								media_fit: section.settings.image_fit,
								show_secondary_image: section.settings.show_secondary_image,
								show_vendor: section.settings.show_vendor,
								show_desc: section.settings.show_desc,
								section_id: section.id,
								show_sku: section.settings.show_sku
							%}
						</div>
						<script type="application/json" class="product-variant-json" data-handle="{{ product.handle }}">
							{"options":{{ product.options | json }},"variants":{{ product.variants | json }}}
						</script>
					{%- endfor -%}
				</div>

				{%- if paginate.pages > 1 -%}
					{%- if settings.pagination_type == 'load_more' -%}
						{% render 'load-more',
							next_url: paginate.next.url,
							count_pages: paginate.pages,
							current_page: paginate.current_page
						%}
						<div class="js-hidden">
							{% render 'pagination', paginate: paginate %}
						</div>
					{%- elsif settings.pagination_type == 'infinite_scroll' -%}
						{% render 'infinite-scroll',
							next_url: paginate.next.url,
							count_pages: paginate.pages,
							current_page: paginate.current_page
						%}
						<div class="js-hidden">
							{% render 'pagination', paginate: paginate %}
						</div>
					{% else %}
						{% render 'pagination', paginate: paginate %}
					{%- endif -%}
				{%- endif -%}
			</div>
		{%- endif -%}
	{%- endpaginate -%}
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			var params = new URLSearchParams(window.location.search);
			var optionFilters = [];
			var entries = Array.from(params.entries());
			for (var ei = 0; ei < entries.length; ei++) {
				var key = entries[ei][0], value = entries[ei][1];
				if (key.indexOf('filter.v.option.') === 0 && value) {
					optionFilters.push({ name: key.replace('filter.v.option.', ''), value: value });
				}
			}
			if (optionFilters.length === 0) return;
			var cards = document.querySelectorAll('.js-color-swatches-wrapper');
			var fmt = function(v) {
				var num = Math.round(v / 100);
				return '$' + num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
			};
			cards.forEach(function(card) {
				var handle = card.getAttribute('data-product');
				if (!handle) return;
				var scriptTag = document.querySelector('.product-variant-json[data-handle="' + handle + '"]');
				if (!scriptTag) return;
				var data;
				try { data = JSON.parse(scriptTag.textContent); } catch(e) { return; }
				var variants = data.variants, prodOptions = data.options || [];
				if (!variants || !prodOptions.length) return;
				var match = null;
				for (var vi = 0; vi < variants.length; vi++) {
					var v = variants[vi], ok = true;
					for (var fi = 0; fi < optionFilters.length; fi++) {
						var f = optionFilters[fi];
						var fName = f.name.toLowerCase().replace(/[^a-z0-9]/g, '');
						var idx = -1;
						for (var oi = 0; oi < prodOptions.length; oi++) {
							if (prodOptions[oi].toLowerCase().replace(/[^a-z0-9]/g, '') === fName) { idx = oi; break; }
						}
						if (idx === -1 || !v.options || v.options[idx] !== f.value) { ok = false; break; }
					}
					if (ok) { match = v; break; }
				}
				if (!match) return;
				if (!match.available) {
					var pc = card.closest('.collection-product-card');
					if (pc) pc.style.display = 'none';
					return;
				}
				var img = card.querySelector('.media--first');
				if (img && match.featured_image && match.featured_image.src) {
					img.src = match.featured_image.src; img.srcset = match.featured_image.src + ' 1x';
				}
				var priceEl = card.querySelector('.price');
				if (priceEl) {
					var rp = priceEl.querySelector('.price-item--regular');
					var sp = priceEl.querySelector('.price-item--sale');
					var cp = priceEl.querySelector('.price__compare .price-item--regular');
					if (rp) rp.textContent = fmt(match.price);
					if (sp) sp.textContent = fmt(match.price);
					if (match.compare_at_price > match.price) {
						priceEl.classList.add('price--on-sale');
						if (cp) cp.textContent = fmt(match.compare_at_price);
					}
				}
				card.querySelectorAll('a').forEach(function(a) {
					var h = a.getAttribute('href') || '';
					if (h.indexOf('/products/') === 0 || h.indexOf('?variant=') >= 0) {
						if (h.indexOf('?variant=') >= 0) a.href = h.replace(/variant=\d+/, 'variant=' + match.id);
						else if (h.indexOf('?') >= 0) a.href += '&variant=' + match.id;
						else a.href += '?variant=' + match.id;
					}
				});
			});
		});
	</script>
</div>
{%- if collection.all_products_count > 0 -%}
	{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
		{%- if use_vertical_filter_layout -%}
			</div>
		{%- endif -%}
	{%- endif -%}
{%- endif -%}

{% schema %}
{
	"name": "t:sections.main-collection-product-grid.name",
	"tag": "section",
	"class": "collection-grid-section",
	"settings": [
		{
			"type": "range",
			"id": "products_per_page",
			"min": 6,
			"max": 23,
			"step": 1,
			"default": 9,
			"label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
		},
		{
			"type": "range",
			"id": "per_row",
			"min": 2,
			"max": 6,
			"step": 1,
			"default": 3,
			"label": "t:sections.all.column_per_row.label",
			"info": "t:sections.all.column_per_row.info"
		},
		{
			"type": "checkbox",
			"id": "mobile_card_count",
			"default": false,
			"label": "t:settings_schema.product_card.settings.mobile_card_count.label"
		},
		{
			"type": "select",
			"id": "taypes_position",
			"default": "in_header",
			"label": "t:sections.main-collection-product-grid.settings.taypes_position.label",
			"options": [
				{
					"value": "in_menu",
					"label": "t:sections.main-collection-product-grid.settings.taypes_position.options__1.label"
				},
				{
					"value": "in_header",
					"label": "t:sections.main-collection-product-grid.settings.taypes_position.options__2.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": false,
			"label": "t:sections.all.product_card.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": true,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "landscape",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "portrait",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.image.fit.label",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.image.fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.image.fit.options__2.label"
				}
			],
			"default": "cover"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.header__1.content"
		},
		{
			"type": "checkbox",
			"id": "enable_filtering",
			"default": true,
			"label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
			"info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
		},
		{
			"type": "select",
			"id": "filter_layout",
			"label": "t:sections.main-collection-product-grid.settings.filter_layout.label",
			"info": "t:sections.main-collection-product-grid.settings.filter_layout.info",
			"default": "drawer",
			"options": [
				{
					"value": "drawer",
					"label": "t:sections.main-collection-product-grid.settings.filter_layout.options__1.label"
				},
				{
					"value": "vertical",
					"label": "t:sections.main-collection-product-grid.settings.filter_layout.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "default_open",
			"default": true,
			"label": "t:sections.main-collection-product-grid.settings.default_open.label"
		},
		{
			"type": "checkbox",
			"id": "enable_sorting",
			"default": true,
			"label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
		},
		{
			"type": "select",
			"id": "facets_count_type",
			"options": [
				{
					"value": "default",
					"label": "t:sections.main-collection-product-grid.settings.facets_count_type.options__1.label"
				},
				{
					"value": "alternative",
					"label": "t:sections.main-collection-product-grid.settings.facets_count_type.options__2.label"
				}
			],
			"default": "default",
			"label": "t:sections.main-collection-product-grid.settings.facets_count_type.label"
		},
		{
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.image_filter.content"
    },
    {
      "type": "select",
      "id": "image_filter_ratio",
      "options": [
				{
          "value": "3/2",
          "label": "t:sections.all.image.ratio.options__1.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.image.ratio.options__2.label"
        },
        {
          "value": "1/1",
          "label": "t:sections.all.image.ratio.options__3.label"
        }
      ],
			"default": "4/5",
      "label": "t:sections.all.image.ratio.label"
    },
    {
      "type": "select",
      "id": "image_filter_fit",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.image.fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.image.fit.options__2.label"
        }
      ],
      "default": "cover",
      "label": "t:sections.all.image.fit.label"
    },
    {
      "type": "range",
      "id": "image_filter_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.main-collection-product-grid.settings.image_filter_columns.label"
    },
		{
			"type": "header",
			"content": "t:sections.all.section_margin.header.content"
		},
		{
			"type": "range",
			"id": "margin_top",
			"min": 0,
			"max": 200,
			"step": 10,
			"default": 0,
			"unit": "px",
			"label": "t:sections.all.section_margin.margin_top.label"
		},
		{
			"type": "range",
			"id": "margin_bottom",
			"min": 0,
			"max": 200,
			"step": 10,
			"default": 0,
			"unit": "px",
			"label": "t:sections.all.section_margin.margin_bottom.label"
		}
	]
}
{% endschema %}
